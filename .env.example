# GRNT 환경변수 예시 — 실제 값은 .env(비커밋) 또는 배포 환경변수로만 넣습니다.

# 실데이터 동기화에만 쓰는 공공데이터포털 인증키
# 15113968(보조금24) · 15125364(K-Startup) · 15157820(기업마당) — 모두 자동승인
# server.json 의 name/repository 는 CLNS-KR/GRNT 로 맞춰 두었습니다.
DATA_GO_KR_SERVICE_KEY=

# 서버
PORT=8787
HOST=0.0.0.0
# Render 배포에서는 render.yaml 이 https://grnt-kr.onrender.com 으로 넣어 줍니다(로컬 실행은 아래 기본값).
PUBLIC_BASE_URL=http://localhost:8787

# 데이터 경로
SUBSIDY_KR_DATA=data/gov24
SUBSIDY_KR_DB=data/app.sqlite
# 익명 카운터(경로·툴·판정 등급·0건 검색어)만 따로 둘 SQLite 경로 — 선택.
# 비어 있으면 SUBSIDY_KR_DB 를 그대로 씁니다. 영속 디스크·백업 볼륨을 마운트했을 때
# 재배포로 통계가 날아가지 않게 하려면 그 경로를 넣으세요(외부 유료 DB 불필요).
GRNT_STATS_PATH=

# 동시 처리·요청 빈도 상한 — 무료 플랜(0.1 vCPU·512MB)에서 요청이 몰릴 때 서버가 함께 터지지 않게.
# 동시에 처리할 요청 수(세마포어). 넘는 요청은 잠시 기다렸다가 503 busy 로 답합니다.
GRNT_MAX_CONCURRENCY=4
# IP별 분당 요청 상한 — 일반(페이지·메타) / 무거운(검색·MCP·배치·문의). 0 이면 끕니다.
# /healthz 는 플랫폼 헬스체크라 상한에서 제외합니다.
GRNT_RATE_LIMIT=300
GRNT_RATE_LIMIT_HEAVY=120

# 문의 유실 대비(선택) — 무료 플랜은 영구 디스크가 없어 재배포 시 SQLite 가 초기화됩니다.
# GRNT_INQUIRY_SINK: 접수 1건당 JSON 한 줄을 덧붙일 파일(영속 디스크 경로를 쓰세요).
# GRNT_INQUIRY_WEBHOOK: 접수 즉시 알림을 받을 운영자 엔드포인트(http/https).
GRNT_INQUIRY_SINK=
GRNT_INQUIRY_WEBHOOK=

# 검색엔진 소유확인(선택) — 값이 비어 있으면 메타태그도 확인 파일도 나가지 않습니다.
# 구글 서치콘솔 · 네이버 서치어드바이저가 발급한 토큰을 그대로 넣으세요.
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
# 루트에 서빙할 확인 파일(JSON 한 줄). 예: {"naver1a2b3c.html": "naver-site-verification: naver1a2b3c.html"}
SITE_VERIFICATION_FILES=

# 일자별 기준일 스냅샷(0.4.6)
# 기동 시 오늘 스냅샷이 없으면 현재 카탈로그로 1장 적재합니다(compare_ledgers 기준일).
# 자동 적재를 끄려면 0. 이미지에 넣은 data/gov24/snapshots/*.json.gz 는 그대로 쓰입니다.
GRNT_SNAPSHOT_BASELINE=1
# 공유 카드(og:image) 파일 경로를 바꿀 때만 지정합니다(기본 <프로젝트>/static/og.png).
GRNT_OG_IMAGE=
