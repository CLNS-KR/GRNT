# GRNT 환경변수 예시 — 실제 값은 .env(비커밋) 또는 배포 환경변수로만 넣습니다.

# 실데이터 동기화에만 쓰는 공공데이터포털 인증키
# 15113968(보조금24) · 15125364(K-Startup) · 15157820(기업마당) — 모두 자동승인
# server.json 의 name/repository 는 CLNS-KR/GRNT 로 맞춰 두었습니다.
DATA_GO_KR_SERVICE_KEY=

# 서버
PORT=8787
HOST=0.0.0.0
# Render 배포에서는 render.yaml 이 https://grnt-kr.onrender.com 으로 넣어 줍니다(로컬 실행은 아래 기본값).
PUBLIC_BASE_URL=http://localhost:8787

# 데이터 경로
SUBSIDY_KR_DATA=data/gov24
SUBSIDY_KR_DB=data/app.sqlite

# 검색엔진 소유확인(선택) — 값이 비어 있으면 메타태그도 확인 파일도 나가지 않습니다.
# 구글 서치콘솔 · 네이버 서치어드바이저가 발급한 토큰을 그대로 넣으세요.
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
# 루트에 서빙할 확인 파일(JSON 한 줄). 예: {"naver1a2b3c.html": "naver-site-verification: naver1a2b3c.html"}
SITE_VERIFICATION_FILES=
